-  return contrast(1, accLum) >= contrast(lum([0x0f, 0x11, 0x15]), accLum) ? "#ffffff" : "#0f1115";
+  return contrast(1, accLum) >= contrast(0, accLum) ? "#ffffff" : "#000000";
 }
 
